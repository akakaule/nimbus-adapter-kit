{
  "$schema": "http://json.schemastore.org/template",
  "author": "NimBus Adapter Kit",
  "classifications": [
    "NimBus",
    "Integration",
    "Worker",
    "Azure Service Bus"
  ],
  "identity": "NimBus.AdapterKit.Adapter",
  "groupIdentity": "NimBus.AdapterKit.Adapter",
  "name": "NimBus adapter (Worker / Container App)",
  "description": "A NimBus adapter that connects one external system (Dataverse, Business Central, F&O, ...) to a NimBus event bus: typed failures, retry rules, circuit breaker, inbox deduplication, tests, provisioner, Aspire AppHost, Bicep and an Azure DevOps pipeline.",
  "shortName": "nimbus-adapter",
  "sourceName": "TemplateAdapter",
  "preferNameDirectory": true,
  "guids": [
    "5d7a3b1e-2c4f-4b8a-9e61-0f3c2a9d7e45"
  ],
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "SystemName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "PascalCase name of the external system, for example BusinessCentral, Dataverse or FinanceOperations. It names the endpoint (BusinessCentralEndpoint), the client (IBusinessCentralClient) and the exception types.",
      "replaces": "ExternalSystem",
      "fileRename": "ExternalSystem"
    },
    "SystemNameLower": {
      "type": "generated",
      "generator": "casing",
      "parameters": {
        "source": "SystemName",
        "toLower": true
      },
      "replaces": "externalsystem"
    },
    "SystemNameCamel": {
      "type": "derived",
      "valueSource": "SystemName",
      "valueTransform": "firstLowerCase",
      "replaces": "externalSystem"
    },
    "Endpoint": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "",
      "description": "The endpoint class name, which is also the Service Bus topic and subscription name, for example ErpEndpoint. Defaults to {SystemName}Endpoint. Must be a C# identifier and unique in the Service Bus namespace."
    },
    "EndpointDefault": {
      "type": "generated",
      "generator": "join",
      "parameters": {
        "symbols": [
          {
            "type": "ref",
            "value": "SystemName"
          },
          {
            "type": "const",
            "value": "Endpoint"
          }
        ],
        "separator": ""
      }
    },
    "EndpointName": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "Endpoint",
        "fallbackVariableName": "EndpointDefault"
      },
      "replaces": "ExternalSystemEndpoint",
      "fileRename": "ExternalSystemEndpoint"
    },
    "Contracts": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "local",
      "description": "Where the catalog (endpoints and events) comes from.",
      "choices": [
        {
          "choice": "local",
          "description": "A Contracts project in this repo (with a sample upstream endpoint and event)."
        },
        {
          "choice": "package",
          "description": "A shared platform catalog package; set ContractsPackageId, ContractsPackageVersion, PlatformType and ContractsFeed."
        }
      ]
    },
    "ContractsPackage": {
      "type": "computed",
      "value": "(Contracts == \"package\")"
    },
    "ContractsPackageId": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Contoso.Platform",
      "description": "Package mode: the catalog package id.",
      "replaces": "CONTRACTS_PACKAGE_ID"
    },
    "ContractsPackageVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "1.0.0",
      "description": "Package mode: the catalog package version (pinned; the catalog decides the topology).",
      "replaces": "CONTRACTS_PACKAGE_VERSION"
    },
    "PlatformType": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "Contoso.Platform.ContosoPlatform",
      "description": "Package mode: the full type name of the catalog's Platform class.",
      "replaces": "PLATFORM_TYPE"
    },
    "ContractsFeed": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "https://pkgs.dev.azure.com/<organisation>/_packaging/<feed>/nuget/v3/index.json",
      "description": "Package mode: the NuGet feed that serves the catalog package (a URL or a folder).",
      "replaces": "CONTRACTS_FEED"
    },
    "Inbox": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Deduplicate redeliveries with the NimBus SQL Server inbox (needs a SQL database for the integration platform)."
    },
    "Ingress": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Add the system-to-bus path: a queue of thin change notifications that the adapter re-reads and publishes as events (with a provisioned queue, a simulator driver and tests)."
    },
    "IngressEnabled": {
      "type": "computed",
      "value": "(Ingress && Contracts == \"local\")"
    },
    "NimBusVersion": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "4.2.0",
      "description": "The Akaule.NimBus.* package version. Match the NimBus version your Resolver and WebApp run.",
      "replaces": "4.2.0",
      "onlyIf": [
        {
          "after": "<NimBusVersion>"
        },
        {
          "after": "nimbusVersion: '"
        }
      ]
    }
  },
  "sources": [
    {
      "exclude": [
        ".template.config/**",
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        "**/.vs/**",
        "**/TestResults/**",
        "**/*.user"
      ],
      "modifiers": [
        {
          "condition": "(!IngressEnabled)",
          "exclude": [
            "src/TemplateAdapter.Adapter/Ingress/**",
            "src/TemplateAdapter.Contracts/ExternalSystem/**",
            "tests/TemplateAdapter.Tests/IngressProcessorTests.cs"
          ]
        },
        {
          "condition": "(ContractsPackage)",
          "exclude": [
            "src/TemplateAdapter.Contracts/**",
            "src/TemplateAdapter.Adapter/Handlers/UpstreamAccountUpdatedHandler.cs",
            "src/TemplateAdapter.Adapter/Mapping/AccountMapper.cs",
            "tests/TemplateAdapter.Tests/HandlerTests.cs",
            "tests/TemplateAdapter.Tests/PipelineTests.cs",
            "TemplateAdapter.slnx",
            "NuGet.config"
          ],
          "rename": {
            "TemplateAdapter.Package.slnx": "TemplateAdapter.slnx",
            "NuGet.Package.config": "NuGet.config"
          }
        },
        {
          "condition": "(!ContractsPackage)",
          "exclude": [
            "TemplateAdapter.Package.slnx",
            "NuGet.Package.config"
          ]
        }
      ]
    }
  ],
  "SpecialCustomOperations": {
    "**/*.bicep": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "//#if"
            ],
            "else": [
              "//#else"
            ],
            "elseif": [
              "//#elseif"
            ],
            "endif": [
              "//#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    },
    "**/*.bicepparam": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [
              "//#if"
            ],
            "else": [
              "//#else"
            ],
            "elseif": [
              "//#elseif"
            ],
            "endif": [
              "//#endif"
            ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  }
}
