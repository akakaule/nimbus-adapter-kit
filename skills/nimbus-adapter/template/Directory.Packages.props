<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- One NimBus version for every Akaule.NimBus.* package. Upgrade NimBus by changing this line;
         keep it equal to the NimBus version your Resolver and WebApp run. -->
    <NimBusVersion>5.6.0</NimBusVersion>
    <AspireVersion>17.0.0</AspireVersion>
  </PropertyGroup>

  <ItemGroup Label="NimBus">
    <PackageVersion Include="Akaule.NimBus.Abstractions" Version="$(NimBusVersion)" />
    <PackageVersion Include="Akaule.NimBus.Core" Version="$(NimBusVersion)" />
    <PackageVersion Include="Akaule.NimBus.SDK" Version="$(NimBusVersion)" />
    <PackageVersion Include="Akaule.NimBus.ServiceBus" Version="$(NimBusVersion)" />
<!--#if (InboxSql) -->
    <PackageVersion Include="Akaule.NimBus.Inbox.SqlServer" Version="$(NimBusVersion)" />
<!--#endif -->
<!--#if (InboxTable) -->
    <PackageVersion Include="Akaule.NimBus.Inbox.AzureTables" Version="$(NimBusVersion)" />
<!--#endif -->
    <PackageVersion Include="Akaule.NimBus.ServiceDefaults" Version="$(NimBusVersion)" />
    <PackageVersion Include="Akaule.NimBus.Testing" Version="$(NimBusVersion)" />
  </ItemGroup>

<!--#if (ContractsPackage)
  <ItemGroup Label="Catalog">
    <PackageVersion Include="CONTRACTS_PACKAGE_ID" Version="CONTRACTS_PACKAGE_VERSION" />
  </ItemGroup>

#endif -->
  <ItemGroup Label="Hosting and clients">
    <PackageVersion Include="Aspire.Azure.Messaging.ServiceBus" Version="$(AspireVersion)" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Local AppHost">
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="$(AspireVersion)" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="$(AspireVersion)" />
    <PackageVersion Include="Akaule.NimBus.AspireHosting" Version="$(NimBusVersion)" />
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="$(AspireVersion)" />
<!--#if (InboxTable) -->
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="$(AspireVersion)" />
<!--#endif -->
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.2" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.2" />
  </ItemGroup>
</Project>
