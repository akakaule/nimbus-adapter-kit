<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>5d7a3b1e-2c4f-4b8a-9e61-0f3c2a9d7e45</UserSecretsId>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AppHost build targets, and AddDotnetProject for the adapter, provisioner and simulator. -->
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <!-- The NimBus Service Bus emulator, Resolver and WebApp as local resources, from packages. -->
    <PackageReference Include="Akaule.NimBus.AspireHosting" />
    <!-- SQL Server for the NimBus message store (and the SQL inbox, when the adapter has one). -->
    <PackageReference Include="Aspire.Hosting.SqlServer" />
<!--#if (InboxTable) -->
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
<!--#endif -->
<!--#if (ContractsPackage)
    <PackageReference Include="CONTRACTS_PACKAGE_ID" />
#endif -->
  </ItemGroup>
<!--#if (!ContractsPackage) -->

  <ItemGroup>
    <!-- The catalog, as an ordinary reference: the WebApp renders it. The projects the AppHost
         runs are added by path in Program.cs and need no reference here. -->
    <ProjectReference Include="..\TemplateAdapter.Contracts\TemplateAdapter.Contracts.csproj" />
  </ItemGroup>
<!--#endif -->

</Project>
