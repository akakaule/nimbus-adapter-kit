<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Hermetic restores: nuget.org for everything, plus the feed that serves the shared catalog
       package. Clearing inherited sources keeps other machine-level feeds from breaking the build.
       A private feed needs credentials: in Azure DevOps the NuGetAuthenticate task provides them. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="catalog" value="CONTRACTS_FEED" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="catalog">
      <package pattern="CONTRACTS_PACKAGE_ID" />
    </packageSource>
  </packageSourceMapping>
</configuration>
